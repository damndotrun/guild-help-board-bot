DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
GUILD_ID=your-discord-server-id-here

# Optional. The web admin's public address (a full https:// URL). Until the web
# admin exists (M3) leave it unset: it only adds an officers-only "Web admin"
# link button to the /menu home screen, shown once this is set.
# PUBLIC_URL=https://admin.example.com
